# Copy to ~/.openclaw/.env (never commit real values)
OPENCLAW_AGENT_MENTION=@openclaw

# Subaru / MySubaru Connected Services (see docs/SUBARU-VEHICLE.md)
SUBARU_ENABLED=0
SUBARU_USERNAME=
SUBARU_PASSWORD_FILE=~/.openclaw/.env.d/subaru-password.secret
SUBARU_PIN_FILE=~/.openclaw/.env.d/subaru-pin.secret
SUBARU_VIN=
SUBARU_COUNTRY=USA
SUBARU_DEVICE_ID=
SUBARU_DEVICE_NAME=openclaw-homelab
SUBARU_VENV=~/.openclaw/venv-subaru
SUBARU_VEHICLE_JSON=~/.openclaw/config/subaru-vehicle.json
SUBARU_CONFIG_FILE=~/.subarulink.cfg
SUBARU_ACTUATION_ENABLED=0
SUBARU_REQUIRE_TALK_CONFIRM=1
SUBARU_FASTPATH_ACTUATION=0
SUBARU_ALERT_TALK_ROOM=
SUBARU_ALERT_MIN_INTERVAL_H=6
SUBARU_LOCATE_MIN_INTERVAL_H=2
SUBARU_MORNING_BRIEF=0
SUBARU_BRIDGE_URL=
SUBARU_BRIDGE_KEY_FILE=~/.openclaw/.env.d/subaru-bridge-key.secret

# Talk read freshness + rate-limit protection.
# Auto-refresh a Talk status read when telemetry is older than this many seconds.
SUBARU_TALK_REFRESH_MAX_AGE_S=300
# Coalesce repeated update/fetch attempts: skip (serve cached) within this many
# seconds of the last attempt. 0 disables the throttle (explicit CLI default).
SUBARU_UPDATE_MIN_INTERVAL_S=0

# Reverse-geocode locate/Location coordinates to a place name (opt-in; OSM Nominatim).
SUBARU_GEOCODE=0

# Multi-vehicle: JSON map of spoken nicknames to VINs, e.g.
# SUBARU_VEHICLE_ALIASES={"outback":"4S4...","solterra":"JTM..."}
SUBARU_VEHICLE_ALIASES=

# Scheduled remote start (cron drives the time; wrapper enforces the gates).
SUBARU_SCHEDULED_START=0
SUBARU_SCHEDULED_START_PRESET=
# SUBARU_SCHEDULED_START_DAYS=Mon Tue Wed Thu Fri
# SUBARU_SCHEDULED_START_ROOM=

# Optional Talk integration (openclaw-skylight or custom talk-post.sh)
# SKYLIGHT_OPS_TALK_ROOM=
# SKYLIGHT_FAMILY_TALK_ROOM=
# TALK_SHIM_PORT=8788
# TALK_SHIM_UPSTREAM=http://127.0.0.1:8787/nextcloud-talk-webhook
# OPENCLAW_ACTOR_IDS=openclaw
# Talk shim binds loopback (127.0.0.1) by default; set to 1 to expose on the LAN.
TALK_SHIM_LAN=0
